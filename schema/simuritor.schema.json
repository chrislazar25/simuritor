{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireMessage",
  "anyOf": [
    {
      "$ref": "#/$defs/ServerMessage"
    },
    {
      "$ref": "#/$defs/ClientMessage"
    }
  ],
  "$defs": {
    "FailoverEvent": {
      "additionalProperties": false,
      "description": "One home dropping out of an export and the fleet covering for it, for the failover log.",
      "properties": {
        "home_id": {
          "type": "string"
        },
        "kind": {
          "description": "`warned`: the home announced it was dropping out; `silent`: detected by missed heartbeats.",
          "enum": [
            "warned",
            "silent"
          ],
          "type": "string"
        },
        "cover_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds from drop-out to full cover; null when not covered this tick."
        },
        "covered_by": {
          "description": "How many homes picked up the lost output.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "home_id",
        "kind",
        "cover_s",
        "covered_by"
      ],
      "title": "FailoverEvent",
      "type": "object"
    },
    "FleetStats": {
      "additionalProperties": false,
      "properties": {
        "available_mw": {
          "description": "What the fleet could physically export this tick: homes on grid, above reserve floor.",
          "minimum": 0,
          "type": "number"
        },
        "promised_mw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "MW committed to the utility for this tick; null when no commitment source is configured."
        },
        "delivered_mw": {
          "description": "Actual fleet discharge to the grid this tick.",
          "minimum": 0,
          "type": "number"
        },
        "utility_call": {
          "description": "True while the utility has called on the fleet's contracted capacity.",
          "type": "boolean"
        },
        "homes_on_grid": {
          "description": "Homes with grid power this tick, including those exporting.",
          "minimum": 0,
          "type": "integer"
        },
        "homes_exporting": {
          "description": "Homes on grid and discharging to it; a subset of `homes_on_grid`.",
          "minimum": 0,
          "type": "integer"
        },
        "homes_on_battery": {
          "description": "Grid down, battery still powering the house.",
          "minimum": 0,
          "type": "integer"
        },
        "homes_dark": {
          "description": "Grid down and battery empty: lights out (ran out).",
          "minimum": 0,
          "type": "integer"
        },
        "homes_dark_by_contract": {
          "description": "Grid down, tier `none`: the house is unpowered by contract while the battery keeps its energy.",
          "minimum": 0,
          "type": "integer"
        },
        "headroom_mwh": {
          "description": "Uncommitted fleet energy: above each home's reserve, its share of the call and the failover buffer.",
          "minimum": 0,
          "type": "number"
        },
        "revenue_usd": {
          "description": "Cumulative since replay start; charging at negative prices earns money.",
          "type": "number"
        },
        "revenue_tick_usd": {
          "description": "Revenue earned this tick alone.",
          "type": "number"
        },
        "penalty_usd": {
          "description": "Cumulative shortfall penalties since replay start (shortfall x interval price).",
          "minimum": 0,
          "type": "number"
        },
        "promise_kept": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Share of called intervals where delivery met the promise, 0-1; null until a call has happened."
        },
        "failovers_warned": {
          "description": "Cumulative failovers where the home warned before dropping out.",
          "minimum": 0,
          "type": "integer"
        },
        "failovers_silent": {
          "description": "Cumulative failovers where the home dropped out without warning (missed heartbeats).",
          "minimum": 0,
          "type": "integer"
        },
        "failovers_uncovered": {
          "description": "Cumulative failovers whose lost output no other home could cover.",
          "minimum": 0,
          "type": "integer"
        },
        "failover_p50_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Median seconds to cover a failover so far; null until one has been covered."
        },
        "failover_max_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Slowest cover so far, seconds; null until one has been covered."
        }
      },
      "required": [
        "available_mw",
        "promised_mw",
        "delivered_mw",
        "utility_call",
        "homes_on_grid",
        "homes_exporting",
        "homes_on_battery",
        "homes_dark",
        "homes_dark_by_contract",
        "headroom_mwh",
        "revenue_usd",
        "revenue_tick_usd",
        "penalty_usd",
        "promise_kept",
        "failovers_warned",
        "failovers_silent",
        "failovers_uncovered",
        "failover_p50_s",
        "failover_max_s"
      ],
      "title": "FleetStats",
      "type": "object"
    },
    "HomeInfo": {
      "additionalProperties": false,
      "description": "Static facts about one home, sent once in `init`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "household": {
          "enum": [
            "standard",
            "medical",
            "elderly",
            "wfh"
          ],
          "type": "string"
        },
        "tier": {
          "description": "Backup contract; every `medical` household is `critical`.",
          "enum": [
            "none",
            "standard",
            "critical"
          ],
          "type": "string"
        },
        "capacity_kwh": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "lat",
        "lon",
        "household",
        "tier",
        "capacity_kwh"
      ],
      "title": "HomeInfo",
      "type": "object"
    },
    "HomeState": {
      "additionalProperties": false,
      "description": "Per-tick state of one home. Joined to `HomeInfo` by `id`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "soc": {
          "description": "State of charge, 0-1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "grid": {
          "description": "True if the home has grid power this tick.",
          "type": "boolean"
        },
        "action": {
          "enum": [
            "charge",
            "discharge",
            "hold",
            "backup"
          ],
          "type": "string"
        },
        "kw": {
          "description": "Battery power magnitude; direction comes from `action`.",
          "minimum": 0,
          "type": "number"
        },
        "src": {
          "enum": [
            "rule",
            "jev",
            "fallback"
          ],
          "type": "string"
        },
        "conf": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Decision confidence, 0-1; null for rule decisions."
        }
      },
      "required": [
        "id",
        "soc",
        "grid",
        "action",
        "kw",
        "src",
        "conf"
      ],
      "title": "HomeState",
      "type": "object"
    },
    "InitMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "init",
          "default": "init",
          "type": "string"
        },
        "start": {
          "description": "Timestamp of tick 0.",
          "format": "date-time",
          "type": "string"
        },
        "end": {
          "description": "Exclusive end of the replay window.",
          "format": "date-time",
          "type": "string"
        },
        "n_ticks": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "homes": {
          "items": {
            "$ref": "#/$defs/HomeInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "start",
        "end",
        "n_ticks",
        "homes"
      ],
      "title": "InitMessage",
      "type": "object"
    },
    "TickMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tick",
          "default": "tick",
          "type": "string"
        },
        "i": {
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "description": "Interval start, ISO 8601 with UTC offset.",
          "format": "date-time",
          "type": "string"
        },
        "price": {
          "description": "Real-time settlement point price, $/MWh. Can be negative.",
          "type": "number"
        },
        "eea": {
          "enum": [
            "Normal",
            "EEA1",
            "EEA2",
            "EEA3"
          ],
          "type": "string"
        },
        "temp_f": {
          "type": "number"
        },
        "homes": {
          "items": {
            "$ref": "#/$defs/HomeState"
          },
          "type": "array"
        },
        "fleet": {
          "$ref": "#/$defs/FleetStats"
        },
        "failovers": {
          "description": "Failovers that started or resolved this tick, oldest first.",
          "items": {
            "$ref": "#/$defs/FailoverEvent"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "i",
        "t",
        "price",
        "eea",
        "temp_f",
        "homes",
        "fleet",
        "failovers"
      ],
      "title": "TickMessage",
      "type": "object"
    },
    "ServerMessage": {
      "title": "ServerMessage",
      "discriminator": {
        "mapping": {
          "init": "#/$defs/InitMessage",
          "tick": "#/$defs/TickMessage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/InitMessage"
        },
        {
          "$ref": "#/$defs/TickMessage"
        }
      ]
    },
    "PauseMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pause",
          "default": "pause",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PauseMessage",
      "type": "object"
    },
    "PlayMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "play",
          "default": "play",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PlayMessage",
      "type": "object"
    },
    "ResetMessage": {
      "additionalProperties": false,
      "description": "Pause at tick 0 and resend `init`.",
      "properties": {
        "type": {
          "const": "reset",
          "default": "reset",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ResetMessage",
      "type": "object"
    },
    "SpeedMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "speed",
          "default": "speed",
          "type": "string"
        },
        "ticks_per_sec": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "type": "number"
        }
      },
      "required": [
        "type",
        "ticks_per_sec"
      ],
      "title": "SpeedMessage",
      "type": "object"
    },
    "ClientMessage": {
      "title": "ClientMessage",
      "discriminator": {
        "mapping": {
          "pause": "#/$defs/PauseMessage",
          "play": "#/$defs/PlayMessage",
          "reset": "#/$defs/ResetMessage",
          "speed": "#/$defs/SpeedMessage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PlayMessage"
        },
        {
          "$ref": "#/$defs/PauseMessage"
        },
        {
          "$ref": "#/$defs/SpeedMessage"
        },
        {
          "$ref": "#/$defs/ResetMessage"
        }
      ]
    }
  }
}
